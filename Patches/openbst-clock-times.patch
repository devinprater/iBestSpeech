+/* A separator that keeps two runs of digits apart: a space, a slash or the
+   colon of a clock time. Each is a state of its own in the transition table,
+   so the runs either side of it arrive as one token. */
+static int is_num_sep(int ch) {
+    return ch == ' ' || ch == '/' || ch == ':';
+}
+
+/* Does the token carry a comma? Only then is it a grouped number's business. */
+static int has_comma(const bst_tok *t) {
+    for (int i = t->start; i <= t->cur; i++)
+        if (t->ring[i] == ',') return 1;
+    return 0;
+}
+
+/* Reads every run of digits in the token as its own number. This is what a run
+   of digits that is NOT a grouped number is -- "5,19" is a pair of numbers,
+   "3,4,5" is three of them -- and it is what the same text already reads as
+   when the separator between the numbers is a hyphen. */
+static int say_groups(bst_tok *t) {
+    int at = -1;
+    for (int i = t->start; i <= t->cur + 1; i++) {
+        if (i <= t->cur && is_digit(t, t->ring[i])) {
+            if (at < 0) at = i;
+            continue;
+        }
+        if (at >= 0) { bst_say_number(t, t->ring + at, i - at); at = -1; }
+    }
+    if (t->money) say_currency(t, t->ring + t->start, t->cur - t->start + 1);
+    t->prevkind = t->kind;
+    t->kind = 6;
+    return 1;
+}
+
+/* Are this token's comma-separated groups the three-digit groups of a grouped
+   number, all the way to the end? "1,000" and "1,234,567" are; "5,19",
+   "3,4,5" and "1,0000" are not. */
+static int is_grouped(const bst_tok *t) {
+    int p = t->start, first = 1;
+    for (;;) {
+        int r = p;
+        while (r <= t->cur && is_digit(t, t->ring[r])) r++;
+        int len = r - p;
+        if (first && (len < 1 || len > 3)) return 0;
+        if (!first && len != 3) return 0;
+        if (r > t->cur || t->ring[r] != ',') return 1;
+        first = 0;
+        p = r + 1;
+    }
+}
